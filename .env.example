# ==============================================================================
# AlertFlow Environment Configuration
# ==============================================================================

# Server Network Configuration
PORT=3001
NODE_ENV=development

# Persistent Database Storage
# Local development default: ./server/data/alertops.db
# Railway Production: Mount a Railway Volume at /data and set DB_PATH=/data/alertops.db
DB_PATH=./server/data/alertops.db

# Cross-Origin & Deployment Origins
# Comma-separated list of allowed frontend origins for CORS and WebSocket handshake
ALLOWED_ORIGINS=https://alertflow-two.vercel.app,http://localhost:5173,http://127.0.0.1:5173
FRONTEND_URL=https://alertflow-two.vercel.app

# Cookie & Session Security
# SameSite policy: 'none' for cross-domain deployments (Vercel frontend -> Railway backend),
# or 'lax' for local development / same-origin reverse-proxy setups.
COOKIE_SAMESITE=none
COOKIE_SECURE=true
SESSION_TTL_DAYS=7

# Authentication Policy
# Set ALLOW_REGISTRATION=false to disable public sign-ups (login only)
ALLOW_REGISTRATION=true
PASSWORD_MIN_LENGTH=12

# Automated Initial Admin Account Bootstrap
# If configured, the backend automatically provisions or updates this admin on boot.
ADMIN_BOOTSTRAP_EMAIL=admin@alertflow.io
ADMIN_BOOTSTRAP_PASSWORD=AdminSecurePassword123!
ADMIN_BOOTSTRAP_NAME=AlertFlow Administrator

# Optional SMTP Email Delivery (for Password Reset & Incident Alerts)
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASS=your-smtp-password
# EMAIL_FROM=noreply@alertflow.io

# ------------------------------------------------------------------------------
# Frontend Environment Variables (Vercel / Vite client)
# ------------------------------------------------------------------------------
# Leave empty or set to /api if using Vercel rewrites to Railway.
# If connecting directly cross-origin, specify Railway public domain:
# VITE_API_BASE_URL=https://<your-backend-app>.up.railway.app
# VITE_WS_URL=wss://<your-backend-app>.up.railway.app/ws
